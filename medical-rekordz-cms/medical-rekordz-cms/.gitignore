# ─── Sensitive Config (generated by installer) ───────────────────────────────
config/app.php
config/database.php
config/superadmin.php
config/mail.php
.env
.env.*

# ─── Storage contents (keep structure via .gitkeep) ──────────────────────────
storage/*
!storage/.gitkeep
!storage/logs/.gitkeep
!storage/uploads/.gitkeep
!storage/uploads/images/.gitkeep
!storage/uploads/audio/.gitkeep
!storage/uploads/documents/.gitkeep
!storage/uploads/videos/.gitkeep
!storage/cache/.gitkeep
!storage/sessions/.gitkeep
!storage/backups/.gitkeep

# ─── Runtime files ────────────────────────────────────────────────────────────
*.log
*.cache
storage/install.lock

# ─── Vendor ───────────────────────────────────────────────────────────────────
vendor/

# ─── OS & editor noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
